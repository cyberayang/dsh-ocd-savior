{
  "name": "@cyberayang/dsh-ocd-savior",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OCD Savior (强迫症拯救者) — adds a permanent \"Delete session\" action to DeepSeek Harness session menus: deletes the conversation log, projection cache, and workspace references.",
  "license": "MIT",
  "author": "cyberayang",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberayang/dsh-ocd-savior.git"
  },
  "homepage": "https://github.com/cyberayang/dsh-ocd-savior#readme",
  "bugs": {
    "url": "https://github.com/cyberayang/dsh-ocd-savior/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "cleanup",
    "ocd-savior"
  ],
  "scripts": {
    "test": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
